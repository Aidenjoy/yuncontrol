.DS_Store
xcuserdata/
*.xcuserstate
__pycache__/
*.py[cod]
.pytest_cache/
.testmondata*
.test-results/
.ruff_cache/
.venv/
# Desktop Connector environment ownership leases.
*.desktop-lock/
*.desktop-lock.lease
.next/
web-next/out/
.env.local
.env.*.local

# Dependency lockfiles are intentionally not committed in this repo.
# Cross-platform package managers rewrite them frequently, creating noise.
uv.lock
yarn.lock
package-lock.json
pnpm-lock.yaml

# Local Claude tooling (launch.json, transcripts, worktree metadata)
.claude/
.codex-run/
.worktrees/
# Local editor/agent project marker (per-machine UUID)
.freebuff/
agent-server/*-review.html

# Local runtime state
.local-dev/
*.sqlite
*.sqlite3
*.db
agent-server/agent-server.files/

# Downloaded uv binaries and CPython builds bundled into the packaged Desktop apps.
desktop-workbench/build/uv/
desktop-workbench/build/python/
desktop-workbench/build/pi-runtime/
desktop-workbench/build/pi-runtime.staging/
desktop-workbench/.cache/
desktop-workbench/release/
desktop-next/build/uv/

# Generated reference-doc caches live under docs/reference locally.
docs/reference/*
!docs/reference/README.md

_reference/*
!_reference/httpx-s3-client/
!_reference/httpx-s3-client/**

yundoc/

# Package dependencies are local, including linked worktree dependencies.
**/node_modules

# Local IDE settings and workspace metadata.
.idea/
.vscode/
*.iml
*.code-workspace

# Environment secrets; keep shareable configuration templates.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template

# Logs, coverage reports, and editor recovery files.
*.log
.coverage
.coverage.*
htmlcov/
coverage/
*.swp
*.swo
*~
*.orig
*.rej

# Generated package metadata and signing credentials.
*.egg-info/
*.tsbuildinfo
*.jks
*.keystore
*.p12
*.pfx
*.mobileprovision
