# 复制为 .env.local

# ========== 监听与跨域 ==========
# 后端监听哪个网卡：127.0.0.1 只本机可访问，0.0.0.0 局域网可访问
AGENT_SERVER_HOST=127.0.0.1
AGENT_SERVER_PORT=8000
# 本地开发填前端地址（5174）；生产 Server 托管静态文件时填对外域名
AGENT_SERVER_PUBLIC_ORIGIN=http://127.0.0.1:5174
# nginx部署保持注释，ip访问填写 http://你的公网IP:5174
# AGENT_SERVER_CORS_ORIGINS=http://192.168.110.152:5174,http://127.0.0.1:5174,http://localhost:5174
# AGENT_SERVER_CORS_ORIGIN_REGEX=^http://(127\.0\.0\.1|localhost):\d+$

# ========== postgresql ==========
# 格式：postgresql+asyncpg://用户名:密码@主机:端口/数据库名
AGENT_SERVER_DB_URL=postgresql+asyncpg://yuncontrol:password@127.0.0.1:5432/yuncontrol
# 数据库字段加密密钥（不能丢失）：openssl rand -hex 32 生成，至少 32 字符，投入使用后不要更换
AGENT_SERVER_SECRET=

# ========== redis ==========
# 不配则单进程模式，崩溃会丢未落盘的 Timeline 消息；多 worker 必须配
# 格式：redis://[用户名:密码@]主机:端口/库号
#   无密码      redis://127.0.0.1:6379/0
#   只有密码    redis://:密码@127.0.0.1:6379/0        （冒号前留空）
#   ACL 用户名  redis://用户名:密码@127.0.0.1:6379/0
#   TLS        rediss://...
# 密码含特殊字符要 URL 编码：@→%40 :→%3A /→%2F #→%23
# ACL 除了常规数据命令，必须允许 INFO server（Timeline 靠它读 run_id）
AGENT_SERVER_REDIS_URL=redis://127.0.0.1:6379/0
# AGENT_SERVER_REDIS_PREFIX=agents-anywhere
# AGENT_SERVER_REDIS_CONNECT_TIMEOUT=5
# AGENT_SERVER_REDIS_HEALTH_CHECK_INTERVAL=30

# ========== utoken 账号打通（对接 utoken / New API 时才配）==========
# 配了之后：普通用户走 utoken 账号登录，关闭本地注册和外部 OAuth，仅本地管理员可用本地凭证
AGENT_SERVER_UTOKEN_URL=http://127.0.0.1:3000
# utoken 调用 /auth/revoke 撤销登录时的共享密钥，至少 32 字符，与 UTOKEN_URL 配套
AGENT_SERVER_AUTH_REVOKE_SECRET=

# ========== Tokens Anywhere 托管 Key（可选）==========
# AGENT_SERVER_TOKENS_URL=https://tokens-anywhere.com
# AGENT_SERVER_TOKENS_ANYWHERE_CLIENT_SECRET=
# AGENT_SERVER_TOKENS_ANYWHERE_REDIRECT_URI=

# ========== 进程与并发 ==========
# 多 worker 必须配 Redis，且不能开 TIMELINE_SINGLE_INSTANCE；空库先用 1 完成初始化
# AGENT_SERVER_WORKERS=1
# AGENT_SERVER_EVENT_WORKERS=2
# AGENT_SERVER_INSTANCE_ID=
# 单实例 Timeline 捷径，仅单 worker 可用
# AGENT_SERVER_TIMELINE_SINGLE_INSTANCE=

# ========== 数据库连接池 ==========
# AGENT_SERVER_DB_POOL_SIZE=10
# AGENT_SERVER_DB_MAX_OVERFLOW=20
# AGENT_SERVER_DB_POOL_TIMEOUT=30
# AGENT_SERVER_DB_POOL_RECYCLE=1800
# AGENT_SERVER_DB_NULL_POOL=
# AGENT_SERVER_MIGRATION_LOCK_TIMEOUT=120

# ========== 上传文件存储 ==========
# local（默认）或 s3
# AGENT_SERVER_FILES_BACKEND=local
# 相对路径基于启动时的工作目录（start.sh 会 cd 到 server/），实际落在 server/.data/files
# 已在 server/.gitignore 忽略；手动从其他目录启动会落到那里，建议用脚本启动
AGENT_SERVER_FILES_LOCAL_ROOT=./.data/files
# backend=s3 时下面必填 BUCKET / ACCESS_KEY / SECRET_KEY
# AGENT_SERVER_FILES_S3_BUCKET=
# AGENT_SERVER_FILES_S3_ACCESS_KEY=
# AGENT_SERVER_FILES_S3_SECRET_KEY=
# AGENT_SERVER_FILES_S3_PREFIX=
# AGENT_SERVER_FILES_S3_REGION=us-east-1
# AGENT_SERVER_FILES_S3_ENDPOINT_URL=
# AGENT_SERVER_FILES_S3_VIRTUAL_HOST_STYLE=false

# ========== Web 静态托管（服务器部署用）==========
# web-next/out 的绝对路径，配了之后 Server 同源托管 Web，不再需要单独跑前端
# AGENT_SERVER_STATIC_DIR=/root/yuncontrol/web-next/out
# AGENT_SERVER_STATIC_DEFAULT_LOCALE=en

# ========== 账号与认证 ==========
# 首个管理员 bootstrap token 有效期（秒），最小 60
# AGENT_SERVER_SETUP_TOKEN_TTL=900
# AGENT_SERVER_PASSWORD_ITERATIONS=120000

# ========== 模型网关 ==========
# 允许把内网/私有地址作为模型网关地址，默认禁止
# AGENT_SERVER_ALLOW_PRIVATE_MODEL_GATEWAYS=

# ========== 性能调优（一般不用改）==========
# AGENT_SERVER_TIMELINE_FLUSH_INTERVAL_SECONDS=1
# AGENT_SERVER_TIMELINE_REVISION_LEASE_SIZE=4096
# AGENT_SERVER_TIMELINE_MAX_LANES=4096
# AGENT_SERVER_TIMELINE_LANE_IDLE_SECONDS=900
# AGENT_SERVER_TIMELINE_PROFILE=
# AGENT_SERVER_TIMELINE_PROFILE_MIN_MS=0
# AGENT_SERVER_EVENT_QUEUE_ITEMS=32
# AGENT_SERVER_EVENT_QUEUE_BYTES=33554432
# AGENT_SERVER_EVENT_THRESHOLD_BYTES=262144
# AGENT_SERVER_USAGE_FLUSH_INTERVAL_SECONDS=1
# AGENT_SERVER_USAGE_RETENTION_DAYS=400
# AGENT_SERVER_NOTIFICATION_CONCURRENCY=4
# AGENT_SERVER_SESSION_RPC_TIMEOUT_SECONDS=10
# AGENT_SERVER_RUNTIME_RPC_TIMEOUT_SECONDS=90
# AGENT_SERVER_DASHBOARD_MIN_INTERVAL_SECONDS=2
# AGENT_SERVER_LOCK_SLOW_MS=0
# AGENT_SERVER_MALLOC_TRIM_INTERVAL_SECONDS=

# ========== 仅 ./local-up.sh / ./desktop-local-up.sh 读取，Server 本身不读 ==========
# 手动启动时这些无效，用上面的 AGENT_SERVER_HOST / PORT
# AGENTS_ANYWHERE_LISTEN_HOST=0.0.0.0
# AGENTS_ANYWHERE_POSTGRES_PORT=55432
# AGENTS_ANYWHERE_REDIS_PORT=56379
# POSTGRES_PASSWORD=agents_anywhere_dev_password
# AGENTS_ANYWHERE_LOCAL_DIR=./.local-dev
# AGENTS_ANYWHERE_LAN_HOST=
# AGENTS_ANYWHERE_NO_BROWSER=
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000
# WEB_HOST=127.0.0.1
# WEB_PORT=5174
# 浏览器请求的 API 地址，build 时固化进产物，改完必须重新 build
# nginx 同域部署保持留空（走同源相对路径）；整行注释掉会默认 http://127.0.0.1:8000
AGENTS_ANYWHERE_API=
# LOGURU_LEVEL=INFO
