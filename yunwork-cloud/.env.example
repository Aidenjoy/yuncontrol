# openssl rand -hex 32 生成；与 yuncontrol Server 的 AGENT_SERVER_YUNWORK_CLOUD_SECRET 相同
YUNWORK_CLOUD_CONTROL_SECRET=
# 控制服务和云大师容器都使用同一个宿主机绝对路径，避免 Docker Socket 的路径歧义
YUNWORK_CLOUD_DATA_ROOT=/srv/yunwork-cloud/users
YUNWORK_CLOUD_IMAGE=yunwork-cloud:local
YUNWORK_CLOUD_DOCKER_BIN=docker
YUNWORK_CLOUD_MEMORY=2g
YUNWORK_CLOUD_CPUS=2
YUNWORK_CLOUD_PIDS_LIMIT=512
YUNWORK_CLOUD_HOST=127.0.0.1
YUNWORK_CLOUD_PORT=8090
